{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "center-panel",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "center.app:create_app", "--factory", "--port", "8080"],
      "env": { "DATABASE_URL": "postgresql+psycopg://ves:ves@localhost:5443/ves_panel" },
      "port": 8080
    },
    {
      "name": "operator-ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "tools.dev_operator_ui", "--offline", "--port", "8077"],
      "env": { "DEMO_OFFLINE": "1" },
      "port": 8077
    }
  ]
}
