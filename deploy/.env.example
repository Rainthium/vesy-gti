# Скопировать в deploy/.env и заполнить. .env в git не попадает (правило №7).

# Пароль БД postgres (генерация: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Секрет подписи cookie панели диспетчера (openssl rand -hex 32)
PANEL_SECRET=

# 1 — cookie панели только по https (флаг Secure). Включать, когда панель
# доступна ИСКЛЮЧИТЕЛЬНО по https: на пилоте в панель ходят и по
# внутреннему http://192.168.140.70/panel/ — с флагом такой вход сломается
PANEL_COOKIE_SECURE=0

# Сервисный токен АИС «СВХ» — команды нативного API v2 (/api/v2/…, контракт
# от 17.08.2026) и скачивание фото (openssl rand -hex 32); передать
# разработчикам АИС при подключении
AIS_PHOTO_TOKEN=

# Учётка совместимого API v1. АИС «СВХ» сегодня шлёт admin/admin —
# до согласованной смены оставить admin (явно: это осознанный выбор,
# центр в проде требует, чтобы переменная была задана)
V1_USERNAME=admin
V1_PASSWORD=admin

# IP-адреса серверов АИС через запятую: боевой 192.168.140.150, тестовый
# 192.168.6.116 (пусто — allowlist команд v2 и фото выключен, только токен)
AIS_ALLOWED_IPS=

# Таможенная система (Таргет-центр ГТС) — deploy/README §2б.
# Токен на чтение документов, справочника объектов и фото (отдельный от
# токена АИС; пусто — доступа нет). Адрес Таргет-центра 192.168.0.115
# добавить в AIS_ALLOWED_IPS выше — список адресов общий.
CUSTOMS_TOKEN=
# Брокер Таргет-центра: URL целиком, с паролем учётной записи vesy-center —
# amqp://vesy-center:ПАРОЛЬ@192.168.0.115:5672/VHOST (тест без TLS) либо
# amqps://…:5671/VHOST. Пусто — публикатор выключен, события копятся.
CUSTOMS_RABBITMQ_URL=
# vesy.events.test — тестовый контур (умолчание); vesy.events — боевой поток,
# ставить только после подтверждения Таргет-центра
CUSTOMS_EXCHANGE=vesy.events.test
# путь к сертификату УЦ брокера ВНУТРИ контейнера app (для amqps)
CUSTOMS_TLS_CA=

# Тайм-аут операции взвешивания v1, секунд (ожидание заезда АТС).
# Поднимая выше ~170, увеличьте proxy_read_timeout в nginx.conf (сейчас 180) —
# иначе nginx оборвёт /api/v1/weigh раньше приложения и АИС получит 504
V1_WEIGH_TIMEOUT_S=120

# Telegram-уведомления мониторинга (агент офлайн, камера, очереди, диск).
# Токен бота — у @BotFather; chat_id — чат/группа, куда бот пишет.
# Пусто — уведомления выключены, события копятся только в журнале панели
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RabbitMQ событий в АИС «СВХ» (свой брокер на ВМ, контракт v2 раздел 7):
# пароль учётки центра vesy-center (openssl rand -hex 24). Учётка АИС ais-svh
# (только чтение очереди) заводится отдельно — deploy/README.md §2а
RABBITMQ_PASSWORD=

# Уровень лога приложения центра в stderr контейнера (docker compose logs app):
# DEBUG / INFO / WARNING / ERROR; пусто или опечатка — INFO
# CENTER_LOG_LEVEL=INFO
